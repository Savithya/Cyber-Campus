# Explicitly choose demo or research. Research NEVER falls back to demo.
APP_MODE=demo
# Required in research mode. These are public Supabase project identifiers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 64 hex characters; generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_SESSION_SECRET=
# 16-character secure secret for researcher dashboard access PIN (uppercase, lowercase, numbers)
# Never commit actual PIN or expose to client bundles. Configure in production environment.
RESEARCHER_ACCESS_PIN=
# Optional server-only Supabase service role key for direct researcher queries (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# Configure real contact/retention and set collection_open in the SQL study_config row.

# Exact origin, without a trailing slash; set this to the Vercel/custom origin when deployed.
APP_ORIGIN=http://127.0.0.1:3005
